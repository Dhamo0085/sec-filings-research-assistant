# ── Secrets ───────────────────────────────────────────────
.env

# ── Large data directories (regenerate with run_ingestion.py) ──
data/raw/
data/qdrant/
# P4-00/D25: the pre-rewrite index, kept so the V0 baseline stays a true v1
# measurement after the corpus is re-parsed and re-indexed. 163 MB.
data/qdrant_v1_backup/
data/parsed/
data/chunks/
data/pending_index/
data/*.log
# P4-12: the re-indexed corpus, staged beside the live one until the owner runs
# scripts/activate_reindex.py. Same sizes as the three above.
data/parsed_v2/
data/chunks_v2/
data/qdrant_v2/
# What that swap renames aside instead of deleting, plus its undo journals.
data/parsed_retired_*/
data/chunks_retired_*/
data/qdrant_retired_*/
data/activation/

# SEC company-ticker registry cache (auto-refreshed weekly, see ingestion/registry.py)
data/company_tickers.json

# Keep manually created evaluation sets
!data/test_sets/

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
*.egg
pip-wheel-metadata/

# ── Virtual environments ──────────────────────────────────
venv/
.venv/
env/
ENV/
.conda/

# ── IDEs ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
.vs/

# ── OS ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# CI writes its junit.xml here. Transient: the phase reports keep their own
# committed test artifacts under reports/phaseN/tests/.
reports/ci/

# ── Logs ─────────────────────────────────────────────────
*.log
logs/

# ── Jupyter ───────────────────────────────────────────────
.ipynb_checkpoints/
# *.ipynb

# ── Testing ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Model cache (downloaded by fastembed / HuggingFace) ──
.cache/
models/
*.onnx

# -- v2 bootstrap (Step 0): local-only and derived artifacts --
.venv*/
data/derived/
data/chat_history.db*
# Runtime bookkeeping written by ingestion/auto_ingest.py
data/auto_ingest_access.json
*.zip
llm/limits.local.yaml
# Extra repo-hygiene patterns supplied by the owner (the old project's
# handle, repository name and hostnames). P2-00(b): never committed, so no
# tracked file names the old project.
.hygiene_local
# ── Owner-signed sheets that were returned unusable ───────
# The narrative rating sheet came back with its columns offset by one and no
# link on the refusal rows, so the `none` entries were defaults rather than
# judgements (D4-09). The narrative gate is recorded as NOT completed and the
# file is deliberately never read or committed. The *blank* sheet
# (narrative_rating_sheet.csv) stays tracked -- it is a build artifact.
reports/phase4/narrative_rating_sheet_signed*.csv
